# 1Password SSH agent.
#
# The agent is a local socket served by the 1Password app, so there is no
# network dependency and no fallback path: if the app is quit, ssh fails
# loudly rather than silently reaching for a key on disk.
Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    # Public key only -- this tells ssh which agent identity to offer without
    # ever reading a private key from disk. It is required alongside
    # IdentitiesOnly, which otherwise falls back to every *default* identity,
    # including the stale ~/.ssh/id_rsa from 2017.
    IdentityFile ~/.ssh/id_ed25519.pub
    IdentitiesOnly yes

Host mjrnas.tail1737c.ts.net
    HostName mjrnas.tail1737c.ts.net
    SetEnv TERM=xterm-256color
