# Proton Pass SSH Agent (primary)
# Falls back to macOS Keychain-unlocked ~/.ssh/id_ed25519 when pass-cli
# is recovering -- same key material, served by Proton in steady state
# and unlocked locally during the inevitable reconnect windows.
Host *
    IdentityAgent "~/.ssh/proton-pass-agent.sock"
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519

Host mjrnas.tail1737c.ts.net
    HostName mjrnas.tail1737c.ts.net
    SetEnv TERM=xterm-256color
