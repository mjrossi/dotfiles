// Shared Zellij options. Machine-specific overrides live in config.local.kdl;
// install.py concatenates the two into config.kdl (never edit that directly).
//
// Deliberately no `keybinds` block: Zellij's defaults are inherited wholesale,
// so each release's new bindings arrive on their own. A previous version of
// this file carried `keybinds clear-defaults=true` followed by a verbatim copy
// of the then-current defaults, which silently froze the keymap and hid
// everything 0.44 and 0.45 added.

theme "tokyonight"

// Startup tips are noise once you know the tool. Release notes stay on, since
// that is how new keybindings get announced.
show_startup_tips false

// Closing the terminal window detaches the session rather than killing it.
// This matches the current default, but it is behaviour worth pinning.
on_force_close "detach"

// Makes file paths in terminal output clickable (Zellij 0.44+).
load_plugins {
    "zellij:link"
}

// What to do when a Zellij session is detected running inside a pane.
// "ask" prompts to either zoom into it or control it on focus.
nested_session_handling "ask"
